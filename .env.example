# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Used by scripts/migrate.mjs and by the API. A unix-socket form also works:
#   postgresql://user@/sora_dev?host=/var/run/postgresql&port=5432
DATABASE_URL=postgresql://sora:<password>@localhost:5432/sora_dev

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Every name below is validated by server/src/config/env.ts at boot — the process
# refuses to start rather than run with a missing/unusable value. A name not
# read by that file does nothing; don't add one here without adding the
# matching field to env.ts first.
NODE_ENV=development
PORT=3000
DATABASE_POOL_MAX=10
# Per-statement cap, wait for a free pooled connection, idle-connection lifetime.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Browser origins allowed to call the API (the Expo web export), comma-separated.
# Native apps are unaffected. Unset: any origin outside production, none in production.
CORS_ORIGINS=

# Signs access tokens. Generate with: openssl rand -base64 48
# The API must refuse to start if this is unset rather than falling back to a
# default -- a hardcoded development secret that reaches production signs tokens
# anyone who has read the source can forge.
JWT_SECRET=
JWT_ISSUER=sora-server

# Access tokens are short-lived because they cannot be revoked; refresh tokens
# are revocable, single-use, and stored only as hashes.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
INVITATION_TTL_DAYS=7

AUTH_RATE_LIMIT_PER_MINUTE=10
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15

APP_VERSION=0.1.0

# The OAuth client id(s) POST /auth/google verifies the ID token's `aud` claim
# against — comma-separated if the mobile app can sign in with more than one
# (e.g. separate Android and iOS clients registered in the same Google Cloud
# project, at https://console.cloud.google.com/apis/credentials). Every client
# id set below in EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID/IOS/WEB that the app can
# actually use to sign in must be listed here too, or that platform's tokens
# fail verification with a mismatched audience.
GOOGLE_CLIENT_ID=

# Read-only approximate dashboard totals in a display currency (BR-07's one exception).
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATE_TIMEOUT_SECONDS=5
EXCHANGE_RATE_CACHE_TTL_MINUTES=720

# ---------------------------------------------------------------------------
# Docker (optional — read by docker-compose.yml only, never by server/src/config/env.ts)
# ---------------------------------------------------------------------------
# Credentials for the containerized Postgres; DATABASE_URL above is for the
# host-Postgres workflow and is unused when running via Docker (the server
# container's DATABASE_URL is built from these against the postgres service).
POSTGRES_USER=sora
# Required: compose refuses to start without it rather than falling back to a default.
POSTGRES_PASSWORD=
POSTGRES_DB=sora_dev

# Host-side port mappings. Postgres uses 5432, the same as a host Postgres;
# change it here if one is already running (see README's Docker section).
POSTGRES_HOST_PORT=5432
# 127.0.0.1 unless something off this machine must reach the container Postgres.
POSTGRES_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=3000

# Postgres GUI tools (pgAdmin 4 & Adminer) — opt-in: `docker compose --profile gui up -d`.
# pgAdmin refuses to start until PGADMIN_DEFAULT_PASSWORD is set.
PGADMIN_HOST_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@sora.com
PGADMIN_DEFAULT_PASSWORD=
ADMINER_HOST_PORT=8080

# ---------------------------------------------------------------------------
# Mobile
# ---------------------------------------------------------------------------
# Only EXPO_PUBLIC_* names are inlined into the bundle; anything else reads as
# undefined in a release build.
#
# Must be a host the DEVICE can reach. On a physical phone "localhost" is the
# phone's own loopback, not your machine, so use your LAN address there
# (e.g. http://192.168.1.20:3000).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# A release (non-__DEV__) build refuses a non-https URL at startup; set true only
# for a LAN preview build against a dev server.
EXPO_PUBLIC_ALLOW_INSECURE_API=
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_DEFAULT_CURRENCY=VND
EXPO_PUBLIC_LOCALE=vi-VN

# Google Sign-In (useGoogleSignIn.ts) — the app's expo-auth-session flow falls
# back to the WEB client id for iOS/Android when their own is unset, so WEB
# alone is usually enough; IOS/ANDROID only matter once a platform-specific
# OAuth client is registered (which needs a bundle id / SHA-1, respectively).
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
