{
  "expo": {
    "name": "Sora",
    "slug": "sora",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sora",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sora.app"
    },
    "android": {
      "package": "com.sora.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "c8173a51-4fc5-4ffc-a75a-f59309cd65be"
      }
    },
    "owner": "tam-le-team"
  }
}
