{
  "name": "sora",
  "private": true,
  "version": "0.1.0",
  "description": "Wallet-model finance tracker — NestJS API, React Native app, PostgreSQL",
  "workspaces": [
    "packages/*",
    "server",
    "mobile"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build --workspace @sora/contracts && npm run build --workspace @sora/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/migrate.mjs --reset",
    "db:test": "node scripts/migrate.mjs --constraints",
    "setup": "npm install && npm run build --workspace @sora/contracts && npm run db:migrate",
    "dev": "concurrently -k -n server,mobile -c blue,magenta \"npm:dev:server\" \"npm:dev:mobile\"",
    "dev:server": "npm run start:dev --workspace @sora/server",
    "dev:mobile": "npm start --workspace @sora/mobile",
    "dev:mobile:clear": "npm run clear --workspace @sora/mobile",
    "agents:sync": "node scripts/sync-agent-skills.mjs",
    "agents:check": "node scripts/sync-agent-skills.mjs --check"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "allowScripts": {
    "argon2@0.41.1": true
  }
}
