{
  "name": "@sora/server",
  "version": "0.1.0",
  "private": true,
  "description": "Wallet-model finance tracker API — NestJS 11, Kysely, PostgreSQL",
  "type": "module",
  "main": "./dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "start:dev": "npm run build && concurrently -k -n tsc,server -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/src/main.js\"",
    "db:migrate": "node ../scripts/migrate.mjs",
    "test": "npm run build && node --import ./dist/test/setup.js --test dist/test/*.test.js"
  },
  "dependencies": {
    "@sora/contracts": "*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "argon2": "^0.41.1",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "~6.0.3"
  }
}
